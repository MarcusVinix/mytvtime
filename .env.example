# ============================================================
# MyTVTime - Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha suas chaves
# ============================================================

# 1. Supabase (https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_public_aqui

# 2. TMDB (https://www.themoviedb.org/settings/api)
# Você pode preencher o Token de Leitura (v4) OU a API Key (v3)
TMDB_READ_ACCESS_TOKEN=seu_token_de_leitura_v4_aqui
TMDB_API_KEY=

# 3. Web Push em segundo plano (Opcional - para notificações com o app fechado)
# Gere as chaves VAPID com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

